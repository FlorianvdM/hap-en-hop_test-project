# Voorbeeld voor LOKAAL werken (WampServer + Mailtrap).
# Kopieer naar .env en vul de lege waarden in. Zet .env nooit op GitHub.
APP_NAME="Hap & Hop"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hap_en_hop
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Mail lokaal via de Mailtrap-sandbox (gegevens uit je eigen Mailtrap-account)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hallo@hapenhop.test"
MAIL_FROM_NAME="${APP_NAME}"

# De gratis Mailtrap-sandbox weigert twee mails vlak na elkaar, daarom 11 seconden pauze.
# Op de echte website: weghalen of op 0 zetten.
HAPHOP_MAIL_PAUZE=11

# Optioneel: AI-functies (pakketadvies en conceptantwoord). Zonder sleutel staan ze uit.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
