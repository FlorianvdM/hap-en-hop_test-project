# Voorbeeld voor de ECHTE website. Kopieer op de server naar .env en vul alles in wat tussen [haken] staat.
# Dit bestand mag wel op GitHub (er staan geen echte gegevens in). De echte .env nooit.
APP_NAME="Hap & Hop"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://[jouwdomein.nl]

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Eigen databasegebruiker met een sterk wachtwoord (niet root, niet leeg)
DB_CONNECTION=mysql
DB_HOST=[databasehost van de hosting, vaak localhost]
DB_PORT=3306
DB_DATABASE=[databasenaam]
DB_USERNAME=[databasegebruiker]
DB_PASSWORD=[sterk wachtwoord]

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Echte mail via de SMTP-gegevens van de hosting of van een mailservice
# Poort 587: MAIL_SCHEME=null. Poort 465: MAIL_SCHEME=smtps.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=[smtp-server]
MAIL_PORT=587
MAIL_USERNAME=[smtp-gebruiker]
MAIL_PASSWORD=[smtp-wachtwoord]
MAIL_FROM_ADDRESS="[bestellingen@jouwdomein.nl]"
MAIL_FROM_NAME="${APP_NAME}"

# Mails direct versturen: geen queue worker nodig en geen pauze
HAPHOP_MAIL_WACHTRIJ=false

# Contactadres op de site en adres voor de melding bij een nieuwe bestelling
HAPHOP_EMAIL=[contactadres@jouwdomein.nl]
HAPHOP_BESTELMELDING_NAAR=[bestelmelding@jouwdomein.nl]

# Alleen voor de EERSTE keer: beheerder aanmaken met "php artisan db:seed --force".
# Haal HAPHOP_ADMIN_WACHTWOORD daarna uit dit bestand en wijzig het wachtwoord in Beheer > Gebruikers.
HAPHOP_ADMIN_EMAIL=[e-mailadres van de eerste beheerder]
HAPHOP_ADMIN_WACHTWOORD=[tijdelijk sterk wachtwoord]

# AI-functies staan uit zolang er geen ANTHROPIC_API_KEY is.